#!/bin/sh
# The setup and teardown contract (docs/designs/scripts-on-every-workroom.md): what a workroom
# script sees. The workroom binary's script runner runs this, for a local workroom and through
# `workroom run-script` for a remote one, and its tests compare the output with the expected file
# for each kind: local.txt or remote.txt.
echo "cwd=$(pwd -P)"
for name in WORKROOM_NAME WORKROOM_PATH WORKROOM_ROOT_PATH WORKROOM_PARENT_DIR WORKROOM_HOST WORKROOM_SHELL_PROBE; do
  eval "value=\${$name-<unset>}"
  echo "$name=$value"
done
