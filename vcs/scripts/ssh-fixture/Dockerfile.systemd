# The ssh fixture's systemd variant (#665): a Linux box that boots systemd as PID 1, with sshd,
# pam_systemd and logind, so a login's session scope, KillUserProcesses and linger behave as on a
# real server. No daemon supervisor: the SSH-host start (macapp/Resources/daemon-bootstrap/start.sh)
# is what's under test. No fake GitHub, fish user or polkit: the tests switch linger and logind as
# root, through the container runtime, never as the ssh user.
#
# run.sh builds it with WR_FIXTURE_SYSTEMD=1, the daemon under test in the build context.
FROM debian:bookworm-slim

# systemd-sysv: /sbin/init. libpam-systemd: an ssh login gets a session scope and starts the user's
# manager, as on any systemd server. dbus and dbus-user-session: loginctl and systemd-run --user
# talk over them. procps: pgrep and pkill for the tests.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd systemd-sysv libpam-systemd dbus dbus-user-session openssh-server procps \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --shell /bin/bash --password '*' workroom \
 && printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PermitRootLogin no' \
      'AllowUsers workroom' \
      'UsePAM yes' \
      > /etc/ssh/sshd_config.d/fixture.conf \
 && mkdir -p /etc/systemd/logind.conf.d \
 && printf '[Login]\nKillUserProcesses=yes\n' > /etc/systemd/logind.conf.d/fixture.conf \
 && rm -f /etc/ssh/ssh_host_* \
 && systemctl mask getty@tty1.service console-getty.service systemd-firstboot.service \
 && systemctl enable ssh.service

COPY --chmod=755 workroom[d] identity.sh systemd-setup.sh /usr/local/bin/
COPY systemd-setup.service /etc/systemd/system/workroom-fixture.service
RUN systemctl enable workroom-fixture.service

ENV container=docker
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
