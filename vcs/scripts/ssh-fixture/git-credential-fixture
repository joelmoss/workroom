#!/bin/sh
# The fixture's git credential helper (FIXTURE=1 only, set in system config by the Dockerfile): the
# stand-in for a remote provider's own GitHub integration, such as boxd's system helper. It answers
# the fixture's GitHub (fake-github.py) with the image's clone token, so a workroom that Workroom
# gives no credential still clones, fetches and pushes on its own.
[ "$1" = get ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat /etc/workroom-fixture/clone-token)"
